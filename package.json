{
  "name": "n8n-nodes-redreplier",
  "version": "0.1.0",
  "description": "n8n community node for RedReplier: react to new Reddit, X, Bluesky and Hacker News mentions and manage monitored websites",
  "license": "MIT",
  "homepage": "https://redreplier.com",
  "keywords": [
    "n8n-community-node-package",
    "redreplier",
    "reddit",
    "social listening"
  ],
  "author": {
    "name": "RedReplier",
    "email": "contact@redreplier.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedReplier/n8n-nodes-redreplier.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/RedReplierApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RedReplier/RedReplier.node.js",
      "dist/nodes/RedReplier/RedReplierTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.47.2",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
